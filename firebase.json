{
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "storage": {
        "rules": "storage.rules"
    },
    "functions": {
        "source": "functions",
        "predeploy": [
            "npm --prefix \"$RESOURCE_DIR\" run build"
        ],
        "ignore": [
            "node_modules",
            ".git",
            "firebase-debug.log",
            "firebase-debug.*.log",
            "*.local",
            "test"
        ]
    },
    "hosting": {
        "public": "hosting/public",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "/i/**",
                "destination": "/invite.html"
            },
            {
                "source": "/get",
                "destination": "/get.html"
            },
            {
                "source": "/",
                "destination": "/get.html"
            }
        ],
        "headers": [
            {
                "source": "/i/**",
                "headers": [
                    {
                        "key": "X-Robots-Tag",
                        "value": "noindex"
                    },
                    {
                        "key": "Referrer-Policy",
                        "value": "no-referrer"
                    },
                    {
                        "key": "Cache-Control",
                        "value": "no-cache"
                    }
                ]
            },
            {
                "source": "**/*.html",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache"
                    }
                ]
            },
            {
                "source": "/og.png",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=86400"
                    }
                ]
            }
        ]
    },
    "emulators": {
        "auth": {
            "port": 9099
        },
        "functions": {
            "port": 5001
        },
        "firestore": {
            "port": 8080
        },
        "storage": {
            "port": 9199
        },
        "hosting": {
            "port": 5050
        },
        "singleProjectMode": true
    },
    "flutter": {
        "platforms": {
            "android": {
                "default": {
                    "projectId": "nod-try",
                    "appId": "1:39831135432:android:12ae5b8ebf8138b003f1fd",
                    "fileOutput": "android/app/google-services.json"
                }
            },
            "ios": {
                "default": {
                    "projectId": "nod-try",
                    "appId": "1:39831135432:ios:689fb8a2e7413ad303f1fd",
                    "uploadDebugSymbols": false,
                    "fileOutput": "ios/Runner/GoogleService-Info.plist"
                }
            },
            "dart": {
                "lib/firebase_options.dart": {
                    "projectId": "nod-try",
                    "configurations": {
                        "android": "1:39831135432:android:12ae5b8ebf8138b003f1fd",
                        "ios": "1:39831135432:ios:689fb8a2e7413ad303f1fd",
                        "macos": "1:39831135432:ios:95e15365da684b6703f1fd",
                        "web": "1:39831135432:web:788f6255cf75219503f1fd"
                    }
                }
            },
            "macos": {
                "default": {
                    "projectId": "nod-try",
                    "appId": "1:39831135432:ios:95e15365da684b6703f1fd",
                    "uploadDebugSymbols": false,
                    "fileOutput": "macos/Runner/GoogleService-Info.plist"
                }
            }
        }
    }
}
