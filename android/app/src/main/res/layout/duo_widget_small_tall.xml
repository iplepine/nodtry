<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2: brand, streak, badge, one row per person. Bound by
     DuoWidgetRenderer.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/duo_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/duo_widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/duo_widget_brand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/duo_widget_placeholder_title"
        android:textColor="@color/duo_widget_text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/duo_widget_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/duo_widget_preview_headline"
        android:textColor="@color/duo_widget_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/duo_widget_badge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/duo_widget_text_secondary"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Only in the placeholder (no data yet): "open the app and connect". -->
    <TextView
        android:id="@+id/duo_widget_placeholder_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="@color/duo_widget_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- A plain View is not allowed in RemoteViews: "Can't load widget". -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/duo_widget_me_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/duo_widget_me_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/duo_widget_preview_me"
            android:textColor="@color/duo_widget_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/duo_widget_me_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/duo_widget_preview_done"
            android:textColor="@color/duo_widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/duo_widget_partner_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/duo_widget_partner_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/duo_widget_preview_partner"
            android:textColor="@color/duo_widget_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/duo_widget_partner_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/duo_widget_preview_pending"
            android:textColor="@color/duo_widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
