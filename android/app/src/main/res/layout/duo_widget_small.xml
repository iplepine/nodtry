<?xml version="1.0" encoding="utf-8"?>
<!-- 2x1: streak + one summary line. Default texts double as the picker
     preview (android:previewLayout). Bound by DuoWidgetRenderer.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/duo_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/duo_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/duo_widget_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/duo_widget_preview_headline"
        android:textColor="@color/duo_widget_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/duo_widget_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/duo_widget_preview_summary"
        android:textColor="@color/duo_widget_text"
        android:textSize="12sp" />
</LinearLayout>
